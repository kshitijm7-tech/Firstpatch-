# GEMINI_API_KEY: Required for Gemini/Gemma AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMMA_MODEL: Required exact Gemma 4 model ID supplied by your AI Studio
# environment. Do not copy a guessed model name; verify availability with the
# configured API credentials before deploying.
GEMMA_MODEL=""

# GITHUB_TOKEN: Optional personal access token (fine-grained or classic with public_repo read access)
# to avoid GitHub unauthenticated rate limits (60 req/hr -> 5,000 req/hr).
GITHUB_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

